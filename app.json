{
  "expo": {
    "name": "Getameal",
    "slug": "Getameal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "getameal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logoWhite.svg",
      "resizeMode": "contain",
      "backgroundColor": "#209D01"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#209D01"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": ""
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/icon.png"
    },
    "plugins": ["expo-video"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
