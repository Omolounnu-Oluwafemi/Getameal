{
  "expo": {
    "name": "Getameal",
    "slug": "Getameal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "getameal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logoWhite.svg",
      "resizeMode": "contain",
      "backgroundColor": "#209D01"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getameal.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#209D01"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.getameal.app"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/icon.png"
    },
    "plugins": [
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5dd350da-3d5c-4f32-8fad-da643164f9f0"
      }
    }
  }
}
